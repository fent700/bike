# Web ───────────────────────────────────────────────
web/node_modules/
web/dist/
web/.env
web/.env.*
!web/.env.example

# iOS ───────────────────────────────────────────────
# The built web bundle is copied in by `npm run build:ios`; generated, never
# committed — two copies of the app would drift the first time one is edited.
ios/Web/
# Generated by `xcodegen generate` from ios/project.yml. Committing it means two
# sources of truth and a merge conflict every time a file is added.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
ios/build/
ios/build.log
DerivedData/
Payload/
*.ipa
*.dSYM.zip
*.mobileprovision
*.p12

# OS / editors ──────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
