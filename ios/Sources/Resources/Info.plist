<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  GENERATE_INFOPLIST_FILE is off for this target, so every required key is
	  spelled out here. Without CFBundleExecutable the OS can't find the binary
	  and without CFBundleIdentifier it can't identify the app at all.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>CFBundleDisplayName</key>
	<string>Bike</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!--
	  Portrait and both landscapes: handlebar mounts come both ways. The web
	  layout adapts; heading is re-referenced to the new top edge natively.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!--
	  Location keeps a recording ride alive with the screen locked or another
	  app in front. Only switched on while recording (LocationService).
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Bike shows where you are on the map, measures speed and distance, and keeps recording your ride while the screen is locked.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>Ride</key>
		<string>Precise location keeps the map, speed and bike-lane detection accurate while you ride.</string>
	</dict>
	<key>NSMotionUsageDescription</key>
	<string>Bike uses the barometer to measure how much you climb on each ride.</string>
</dict>
</plist>
